% Custom \pseudo command (defined in the preamble)
\newcommand{\pseudo}[2]{%
    \begin{table}[ht]
        \renewcommand{\arraystretch}{1.2} % Adjust row spacing
        \centering
        \begin{tabular}{@{}l@{}}
            % \fontsize{10}{12}\selectfont % Change font size here
            \multicolumn{1}{l}{\textbf{#1}} \\ \hline
            #2 \\ \hline
        \end{tabular}
    \end{table}
}

