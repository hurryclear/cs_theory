% Table of contents color and indentation
%-------- Many thanks to Victor Jüttner for this part -----------------------
\setbeamercolor{section in toc}{fg=granat}

\defbeamertemplate{section in toc}{mysections numbered}
{\leavevmode
	\parbox[t]{2em}{\inserttocsectionnumber.}
	\parbox[t]{.4\textwidth}{\inserttocsection}\par}
\setbeamertemplate{section in toc}[mysections numbered]

\defbeamertemplate{subsection in toc}{mysubsections numbered}
{\leavevmode
	\hspace{2em}
	\parbox[t]{2em}{\inserttocsectionnumber.\inserttocsubsectionnumber}
	\parbox[t]{.4\textwidth}{\inserttocsubsection}\par}
\setbeamertemplate{subsection in toc}[mysubsections numbered]

\defbeamertemplate{subsubsection in toc}{mysubsubsections numbered}
{\leavevmode
	\hspace{4em}
	\parbox[t]{3em}{\inserttocsectionnumber.\inserttocsubsectionnumber.\inserttocsubsubsectionnumber}
	\parbox[t]{.4\textwidth}{\inserttocsubsubsection}\par}
\setbeamertemplate{subsubsection in toc}[mysubsubsections numbered]
%--------------------------------------------------------------------------
\def\definepagelayoutwithAR{
	\ifnum \BeamerAspectRatio=169
        \SpecialPageLayout
    \else
        \specialpagelayout
    \fi
}
% Define table of contents command with spacing adjustments
\newcommand{\maketableofcontents}[1][]{
    \begin{frame}{Outline}
    \label{outline}
        \ifx\relax#1\relax
            \tableofcontents
        \else
            \tableofcontents[#1,subsectionstyle=show/show/hide]
        \fi
    \end{frame}
    % Adjust spacing for TOC
    \setbeamerfont{section in toc}{size=\large}  % Section font size
    \setbeamerfont{subsection in toc}{size=\normalsize} % Subsection font size
    \setlength{\itemsep}{1em} % Spacing between lines
}

%% This will show table of content slides before move to each subsection //TODO: Figure out how to make it work
\newcommand{\makesubsectionpopup}{
\AtBeginSubsection[]
{{
    \definepagelayoutwithAR
    \begin{frame}{Outline}
        \tableofcontents[currentsection,currentsubsection]
        \vspace*{2em}
    \end{frame}
}}
}

\newcommand{\makesectionpopup}{
\AtBeginSection[]{{
    \definepagelayoutwithAR
    \begin{frame}
        \hyperlink{outline}{\textbf{\LARGE {\insertsection}}}
    \end{frame}
}}
}


