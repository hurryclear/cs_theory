            \PYG{k}{def} \PYG{n+nf}{rANS\PYGZus{}decoder}\PYG{p}{(}\PYG{n}{symbol\PYGZus{}counts}\PYG{p}{,} \PYG{n}{x}\PYG{p}{):}
                \PYG{n}{cumul\PYGZus{}freq} \PYG{o}{=} \PYG{p}{[]}  \PYG{c+c1}{\PYGZsh{} c\PYGZus{}s}
                \PYG{n}{sum\PYGZus{}freq} \PYG{o}{=} \PYG{l+m+mi}{0} \PYG{c+c1}{\PYGZsh{} m}
                \PYG{n}{output} \PYG{o}{=} \PYG{p}{[]}  \PYG{c+c1}{\PYGZsh{} List to store decoded symbols and states}
                \PYG{c+c1}{\PYGZsh{} compute m and c\PYGZus{}s}
                \PYG{k}{for} \PYG{n}{count} \PYG{o+ow}{in} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{:}
                    \PYG{n}{cumul\PYGZus{}freq}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{sum\PYGZus{}freq}\PYG{p}{)}
                    \PYG{n}{sum\PYGZus{}freq} \PYG{o}{+=} \PYG{n}{count}
                \PYG{k}{while} \PYG{n}{x} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}
                    \PYG{n}{slot} \PYG{o}{=} \PYG{n}{x} \PYG{o}{\PYGZpc{}} \PYG{n}{sum\PYGZus{}freq}  \PYG{c+c1}{\PYGZsh{} Find the slot in the cumulative frequency range}
                    \PYG{n}{s} \PYG{o}{=} \PYG{n}{bisect\PYGZus{}right}\PYG{p}{(}\PYG{n}{cumul\PYGZus{}freq}\PYG{p}{,} \PYG{n}{slot}\PYG{p}{)} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1} \PYG{c+c1}{\PYGZsh{} Binary search to find the symbol s (slot).}
                    \PYG{n}{F\PYGZus{}s} \PYG{o}{=} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}         \PYG{c+c1}{\PYGZsh{} Frequency of the symbol}
                    \PYG{n}{c\PYGZus{}s} \PYG{o}{=} \PYG{n}{cumul\PYGZus{}freq}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}            \PYG{c+c1}{\PYGZsh{} Cumulative count of the symbol}
                    \PYG{n}{output}\PYG{o}{.}\PYG{n}{append}\PYG{p}{((}\PYG{n}{s}\PYG{p}{,}\PYG{n}{x}\PYG{p}{))}           \PYG{c+c1}{\PYGZsh{} Append decoded symbol to the output}
                    \PYG{n}{x} \PYG{o}{=} \PYG{p}{(}\PYG{n}{x} \PYG{o}{//} \PYG{n}{sum\PYGZus{}freq}\PYG{p}{)} \PYG{o}{*} \PYG{n}{F\PYGZus{}s} \PYG{o}{+} \PYG{n}{x} \PYG{o}{\PYGZpc{}} \PYG{n}{sum\PYGZus{}freq} \PYG{o}{\PYGZhy{}} \PYG{n}{c\PYGZus{}s}  \PYG{c+c1}{\PYGZsh{} Update the state}
                \PYG{k}{return} \PYG{n}{output}\PYG{p}{,} \PYG{n}{state}
\end{Verbatim}
