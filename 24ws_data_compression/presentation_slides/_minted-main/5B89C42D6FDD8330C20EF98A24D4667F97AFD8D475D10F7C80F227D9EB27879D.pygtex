\PYG{x}{        for s in s\PYGZus{}input:}
\PYG{x}{            F\PYGZus{}s = symbol\PYGZus{}counts[s]}
\PYG{x}{            c\PYGZus{}s = cumul\PYGZus{}freq[s]}
\PYG{x}{            L\PYGZus{}s = F\PYGZus{}s \PYGZsh{} k = 1}
\PYG{x}{            maxX\PYGZus{}s = 2 * L\PYGZus{}s \PYGZhy{} 1}
