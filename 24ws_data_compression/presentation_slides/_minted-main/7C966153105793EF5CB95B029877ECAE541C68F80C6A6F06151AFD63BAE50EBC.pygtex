            \PYG{k}{def} \PYG{n+nf}{rANS\PYGZus{}decoder}\PYG{p}{(}\PYG{n}{symbol\PYGZus{}counts}\PYG{p}{,} \PYG{n}{num\PYGZus{}symbols}\PYG{p}{,} \PYG{n}{state}\PYG{p}{):}
                \PYG{n}{cumul\PYGZus{}counts} \PYG{o}{=} \PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}  \PYG{c+c1}{\PYGZsh{} Start with 0 as the first cumulative frequency}
                \PYG{n}{total\PYGZus{}frequency} \PYG{o}{=} \PYG{n+nb}{sum}\PYG{p}{(}\PYG{n}{symbol\PYGZus{}counts}\PYG{p}{)}
                \PYG{k}{for} \PYG{n}{count} \PYG{o+ow}{in} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{:}
                    \PYG{n}{cumul\PYGZus{}counts}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{cumul\PYGZus{}counts}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{+} \PYG{n}{count}\PYG{p}{)}
                \PYG{k}{def} \PYG{n+nf}{c\PYGZus{}inv}\PYG{p}{(}\PYG{n}{y}\PYG{p}{):}
                    \PYG{k}{return} \PYG{n}{bisect\PYGZus{}right}\PYG{p}{(}\PYG{n}{cumul\PYGZus{}counts}\PYG{p}{,} \PYG{n}{y}\PYG{p}{)} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}
                \PYG{c+c1}{\PYGZsh{} Decoding process}
                \PYG{n}{output} \PYG{o}{=} \PYG{p}{[]}  \PYG{c+c1}{\PYGZsh{} List to store decoded symbols}
                \PYG{k}{for} \PYG{n}{\PYGZus{}} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}symbols}\PYG{p}{):}
                    \PYG{n}{slot} \PYG{o}{=} \PYG{n}{state} \PYG{o}{\PYGZpc{}} \PYG{n}{total\PYGZus{}frequency}  \PYG{c+c1}{\PYGZsh{} Find the slot in the cumulative frequency range}
                    \PYG{n}{s} \PYG{o}{=} \PYG{n}{c\PYGZus{}inv}\PYG{p}{(}\PYG{n}{slot}\PYG{p}{)}                 \PYG{c+c1}{\PYGZsh{} Get the symbol corresponding to the slot}
                    \PYG{n}{Fs} \PYG{o}{=} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}           \PYG{c+c1}{\PYGZsh{} Frequency of the symbol}
                    \PYG{n}{Cs} \PYG{o}{=} \PYG{n}{cumul\PYGZus{}counts}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}            \PYG{c+c1}{\PYGZsh{} Cumulative count of the symbol}
                    \PYG{n}{output}\PYG{o}{.}\PYG{n}{append}\PYG{p}{((}\PYG{n}{s}\PYG{p}{,}\PYG{n}{state}\PYG{p}{))}                \PYG{c+c1}{\PYGZsh{} Append decoded symbol to the output}
                    \PYG{n}{state} \PYG{o}{=} \PYG{p}{(}\PYG{n}{state} \PYG{o}{//} \PYG{n}{total\PYGZus{}frequency}\PYG{p}{)} \PYG{o}{*} \PYG{n}{Fs} \PYG{o}{+} \PYG{p}{(}\PYG{n}{slot} \PYG{o}{\PYGZhy{}} \PYG{n}{Cs}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} Update the state}

                \PYG{k}{return} \PYG{n}{output}\PYG{p}{,} \PYG{n}{state}
\end{Verbatim}
