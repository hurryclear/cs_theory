                \PYG{k}{for} \PYG{n}{s} \PYG{o+ow}{in} \PYG{n}{s\PYGZus{}input}\PYG{p}{:}
                    \PYG{n}{Fs} \PYG{o}{=} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}
                    \PYG{n}{Cs} \PYG{o}{=} \PYG{n}{cumul\PYGZus{}counts}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}
                    \PYG{n}{state} \PYG{o}{=} \PYG{p}{(}\PYG{n}{state} \PYG{o}{//} \PYG{n}{Fs}\PYG{p}{)} \PYG{o}{*} \PYG{n}{sum\PYGZus{}counts} \PYG{o}{+} \PYG{n}{Cs} \PYG{o}{+} \PYG{p}{(}\PYG{n}{state} \PYG{o}{\PYGZpc{}} \PYG{n}{Fs}\PYG{p}{)}
