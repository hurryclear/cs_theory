                \PYG{n}{sum\PYGZus{}counts} \PYG{o}{=} \PYG{l+m+mi}{0}
                \PYG{k}{for} \PYG{n}{count} \PYG{o+ow}{in} \PYG{n}{symbol\PYGZus{}counts}\PYG{p}{:}
                    \PYG{n}{cumul\PYGZus{}counts}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{sum\PYGZus{}counts}\PYG{p}{)}
