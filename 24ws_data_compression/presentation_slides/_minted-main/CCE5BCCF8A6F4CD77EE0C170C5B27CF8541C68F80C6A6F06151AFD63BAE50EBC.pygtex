                \PYG{k}{return} \PYG{n}{output}\PYG{p}{,} \PYG{n}{state}\PYG{p}{,} \PYG{n}{L\PYGZus{}avg}\PYG{p}{,} \PYG{n}{entropy}\PYG{p}{(}\PYG{n}{symbol\PYGZus{}counts}\PYG{p}{)}
